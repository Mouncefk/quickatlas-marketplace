# Copiez ce fichier vers ".env" (sans ".example") et remplissez vos vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être partagé ni versionné (il est déjà exclu par .gitignore).

# --- Envoi d'email (vérification de compte, réinitialisation de mot de passe) ---
# Exemple pour Gmail : générez un "mot de passe d'application" (voir README),
# n'utilisez jamais votre vrai mot de passe Gmail ici.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=votre-mot-de-passe-application-16-caracteres
MAIL_FROM=votre-adresse@gmail.com

# --- Adresse publique du site (utilisée dans les liens envoyés par email) ---
# En local, laissez la valeur par défaut. Une fois déployé, remplacez par
# votre vrai nom de domaine, par exemple : https://quickatlas.net
SITE_URL=http://localhost:3000

# --- Port d'écoute du serveur (optionnel, 3000 par défaut) ---
# PORT=3000

# --- Connexion via Google (optionnel) ---
# Créez un identifiant OAuth "Web application" sur https://console.cloud.google.com/apis/credentials
# et ajoutez l'URL de votre site aux "Authorized JavaScript origins".
# Tant que cette variable est absente, le bouton Google reste simplement masqué.
# GOOGLE_CLIENT_ID=votre-identifiant.apps.googleusercontent.com
